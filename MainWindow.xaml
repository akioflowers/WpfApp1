<Window x:Class="WpfApp1.MainWindow"

xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

Title="Умная напоминалка" Height="500" Width="750"

WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TimeLabel"
               FontSize="20"
               FontWeight="Bold"
               Margin="0,0,0,10"/>
        <GroupBox Grid.Row="1" Header="Новое напоминание" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Часы"/>
                    <TextBox x:Name="HourBox"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,5,0">
                    <TextBlock Text="Минуты"/>
                    <TextBox x:Name="MinuteBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,5,0">
                    <TextBlock Text="Текст напоминания"/>
                    <TextBox x:Name="TextBoxReminder"/>
                </StackPanel>
                <Button Grid.Column="3"
                    Content="Добавить"
                    Height="28"
                    VerticalAlignment="Bottom"
                    Click="AddButton_Click"/>
            </Grid>
        </GroupBox>
        <DataGrid x:Name="RemindersGrid"
              Grid.Row="2"
              Margin="0,10,0,10"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              CanUserAddRows="False"
              AlternatingRowBackground="#E3F2FD">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Часы"
                                Binding="{Binding Hour}"
                                Width="70"/>
                <DataGridTextColumn Header="Минуты"
                                Binding="{Binding Minute}"
                                Width="70"/>
                <DataGridTextColumn Header="Текст"
                                Binding="{Binding Text}"
                                Width="*"/>
                <DataGridCheckBoxColumn Header="Показано"
                                    Binding="{Binding IsShown}"
                                    Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
            <Button Content="Удалить"
                Width="90"
                Margin="5"
                Click="DeleteButton_Click"/>
            <Button Content="Открыть"
                Width="90"
                Margin="5"
                Click="OpenButton_Click"/>
            <Button Content="Сохранить"
                Width="90"
                Margin="5"
                Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>

</Window>